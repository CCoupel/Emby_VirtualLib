      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "kubernetes",
          "services": [
            "emby2"
          ]
        },
        "access": {
          "method": "kubeconfig",
          "kubeconfig": "private/kubeconfig.yml",
          "namespace": "media",
          "credentials_env": [],
          "verified": {
            "status": "skipped",
            "at": "2026-10-31T14:55:55Z",
            "checks": [
              "kube-auth"
            ],
            "error": "Rancher 403 — User system:unauthenticated (jeton kubeconfig invalide/expire)"
          }
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "kubernetes",
          "services": [
            "emby"
          ]
        },
        "access": {
          "method": "kubeconfig",
          "kubeconfig": "private/kubeconfig.yml",
          "namespace": "media",
          "credentials_env": [],
          "verified": {
            "status": "skipped",
            "at": "2026-10-31T14:55:55Z",
            "checks": [
              "kube-auth",
              "gh-push"
            ],
            "error": "Rancher 403 — User system:unauthenticated ; gh push OK"
          }
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "xunit",
      "moq"
    ],
    "frontend": [],
    "e2e": [],
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50
  },
  "security": {
    "concerns": [
      "remote-server-credentials"
    ]
  },
