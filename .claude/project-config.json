{
  "name": "VirtualLib",
  "team_name": "virtuallib-team",
  "org": "CCoupel",
  "project": "Emby_VirtualLib",
  "description": "Plugin Emby agregant des bibliotheques de serveurs medias distants (Emby, Jellyfin, Plex) comme bibliotheques virtuelles natives, avec proxy transparent pour le streaming et le transcodage.",
  "version": "1.11.0.0",
  "initialized_at": "2026-08-04",
  "initialized_from": "analysis",
  "stack": {
    "backend": null,
    "frontend": null,
    "mobile": null,
    "firmware": null,
    "plugin": {
      "platform": "Emby Plugin (C#/.NET 6)"
    },
    "database": null
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "kubernetes"
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "kubernetes"
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "xunit",
      "moq"
    ],
    "frontend": [],
    "e2e": [],
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50
  },
  "security": {
    "concerns": [
      "remote-server-credentials"
    ]
  },
  "commands": {
    "build": "dotnet build src/VirtualLib --configuration Release --output dist",
    "test": "dotnet test tests/VirtualLib.Tests/",
    "lint": "",
    "audit": "dotnet list src/VirtualLib package --vulnerable",
    "typecheck": ""
  },
  "agents": {
    "idle_ttl_minutes": 15,
    "idle_warning_interval_minutes": 5
  },
  "template_version": {
    "tag": "v3.9.1",
    "commit": "dc3d230f01188ea698f3eab3e7805cbaca9b0260"
  },
  "docs": {
    "mockup_dir": "docs/mockup"
  },
  "marketing": {
    "site": "auto"
  },
  "version_file": ".claude/project-config.json",
  "src_dir": "src/VirtualLib"
}
