<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.69" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtualLib\VirtualLib.csproj" />
  </ItemGroup>

  <!--
    VirtualLib.csproj references these as Private=false (the Emby host provides them at
    runtime — bundling private copies into the shipped plugin risks type-identity mismatches).
    The test host runs standalone, outside Emby, so it needs its own local copies to resolve
    types that touch MediaBrowser.* (e.g. reflecting into ConfigController, which inherits
    BaseApiService). Private=true (default) here only affects this test project's own output,
    never the packaged plugin.
  -->
  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>..\..\libs\MediaBrowser.Common.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>..\..\libs\MediaBrowser.Controller.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>..\..\libs\MediaBrowser.Model.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
